    Icon = "activity"
})

-- Etiqueta para mostrar el estado real (RACE LIVE o Descanso) debajo del botón
local LabelStatus = TabFarm:Paragraph({
    Title = "Estado del Evento / Tiempo Real",
    Content = "Sincronizando reloj..."
})

TabFarm:Toggle({
    Title = "Even race",
    Description = "Automatización con ciclos de 10 min (Live) y carril estricto Z.",
    Default = false,
    Callback = function(state)
        eventRunning = state
        if eventRunning then
            task.spawn(function()
                while eventRunning do
                    ejecutarCicloEvento()
                    task.wait(1)
                end
            end)
        else
            local char = LocalPlayer.Character
            if char and char:FindFirstChildOfClass("Humanoid") then
                char:FindFirstChildOfClass("Humanoid").WalkSpeed = 16
            end
        end
    end
})

-- Hilo en segundo plano para actualizar en tiempo real el texto del estado en la UI
task.spawn(function()
    while true do
        pcall(function()
            leerEstadoCarreraReal()
            if LabelStatus then
                LabelStatus:SetDesc("Estado actual: " .. estadoActualUI)
            end
        end)
        task.wait(1)
    end
end)

